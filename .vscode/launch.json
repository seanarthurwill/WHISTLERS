{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Whistl3rApi",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/services/Whistl3rApi/bin/Debug/net8.0/Whistl3rApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/Whistl3rApi",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}