{
  "family": "whistl3r-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [ "FARGATE" ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::636017849911:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::636017849911:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "whistl3r-api",
      "image": "636017849911.dkr.ecr.us-east-2.amazonaws.com/whistl3r-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ASPNETCORE_ENVIRONMENT",
          "value": "Production"
        },
        {
          "name": "ASPNETCORE_URLS",
          "value": "http://+:8080"
        },
        {
          "name": "AWS__Region",
          "value": "us-east-2"
        }
      ],
      "secrets": [
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:636017849911:secret:whistl3r/db-connection:ConnectionString::"
        },
        {
          "name": "Jwt__SecretKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:636017849911:secret:whistl3r/jwt:SecretKey::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/whistl3r-api",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [ "CMD-SHELL", "curl -f http://localhost:8080/health || exit 1" ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}